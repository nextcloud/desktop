.tag                    export-subst
.gitignore              export-ignore
.gitattributes          export-ignore
.commit-template        export-ignore
binary/                 export-ignore

# Generated Qt Linguist translation files: never let Git attempt a
# content-level 3-way merge on these. They are heavily reordered/reformatted
# machine-generated XML, so a line-based diff3 merge can misalign <message>
# blocks and silently corrupt translations without producing a detectable
# error. Instead, always take whichever side is being merged in - the
# translation_scripts/merge_translation.py pipeline (run automatically via
# .githooks/post-merge + post-commit for stable-x.y merges) then reconciles
# that against the current source tree.
# One-time setup per clone: git config merge.nc-take-incoming.driver "cp -- '%B' '%A'"
translations/client_*.ts merge=nc-take-incoming
