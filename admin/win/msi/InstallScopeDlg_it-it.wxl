<!-- Texts of the installation scope wizard page (InstallScopeDlg.wxs) -->
<WixLocalization Culture="it-it" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="NcInstallScopeDlgPerMachine">Installa per tutti gli utenti di questo &amp;computer</String>
    <String Id="NcInstallScopeDlgPerUser">Installa solo per &amp;me ([LogonUser])</String>
    <String Id="NcInstallScopeDlgPerUserWarning">Con questa opzione, Esplora file non può mostrare le icone dello stato di sincronizzazione di file e cartelle quando si utilizza la sincronizzazione selettiva. I file virtuali non sono interessati.</String>
</WixLocalization>
