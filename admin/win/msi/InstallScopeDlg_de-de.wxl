<WixLocalization Culture="de-de" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="NcInstallScopeDlgPerMachine">Für alle Benutzer dieses &amp;Computers installieren</String>
    <String Id="NcInstallScopeDlgPerUser">Nur für &amp;mich installieren ([LogonUser])</String>
    <String Id="NcInstallScopeDlgPerUserWarning">Mit dieser Option kann der Datei-Explorer bei Verwendung der selektiven Synchronisierung keine Synchronisierungsstatus-Symbole für Dateien und Ordner anzeigen. Virtuelle Dateien sind nicht betroffen.</String>
