<!-- Texts of the installation scope wizard page (InstallScopeDlg.wxs) -->
<WixLocalization Culture="en-us" Codepage="1252" xmlns="http://schemas.microsoft.com/wix/2006/localization">
    <String Id="NcInstallScopeDlgPerMachine">Install for all users of this &amp;machine</String>
    <String Id="NcInstallScopeDlgPerUser">Install just for &amp;you ([LogonUser])</String>
    <String Id="NcInstallScopeDlgPerUserWarning">With this option, File Explorer cannot show the sync status icons of files and folders when selective synchronization is used. Virtual files are not affected.</String>
</WixLocalization>
